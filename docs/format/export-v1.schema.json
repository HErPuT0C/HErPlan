{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/HErPuT0C/HErPlan/blob/main/docs/format/export-v1.schema.json",
  "title": "HErPlan story export, version 1",
  "description": "Story graphs, variables and world cards exported for game engines. See export-v1.md. Unknown fields may appear in later exports with the same version and must be ignored.",
  "type": "object",
  "required": [
    "format",
    "version",
    "exportedWith",
    "exportedAt",
    "project",
    "variables",
    "entities",
    "story"
  ],
  "properties": {
    "format": { "const": "herplan-export" },
    "version": { "const": 1 },
    "exportedWith": {
      "type": "string",
      "description": "HErPlan version that wrote the file."
    },
    "exportedAt": { "type": "string", "format": "date-time" },
    "project": {
      "type": "object",
      "required": ["id", "name"],
      "properties": { "id": { "type": "string" }, "name": { "type": "string" } }
    },
    "variables": { "type": "array", "items": { "$ref": "#/$defs/variable" } },
    "entities": { "type": "array", "items": { "$ref": "#/$defs/entity" } },
    "schema": {
      "type": "object",
      "description": "Since 0.3: entity types (each with every field its entities have) and property sets.",
      "required": ["types", "propertySets"],
      "properties": {
        "types": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name", "builtIn", "parent", "fields"],
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "builtIn": { "type": "boolean" },
              "parent": { "type": ["string", "null"] },
              "fields": {
                "type": "array",
                "items": { "$ref": "#/$defs/field" }
              }
            }
          }
        },
        "propertySets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name", "fields"],
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "fields": {
                "type": "array",
                "items": { "$ref": "#/$defs/field" }
              }
            }
          }
        }
      }
    },
    "story": {
      "type": "object",
      "required": ["root", "graphs"],
      "properties": {
        "root": {
          "type": ["string", "null"],
          "description": "Id of the chapter overview graph."
        },
        "graphs": { "type": "array", "items": { "$ref": "#/$defs/graph" } }
      }
    }
  },
  "$defs": {
    "field": {
      "type": "object",
      "required": ["id", "label", "type"],
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "type": {
          "enum": [
            "text",
            "richtext",
            "number",
            "percent",
            "bool",
            "enum",
            "ref",
            "refList",
            "image",
            "color",
            "table"
          ]
        },
        "options": { "type": "array", "items": { "type": "string" } },
        "target": { "type": ["string", "null"] },
        "columns": { "type": "array", "items": { "type": "string" } }
      }
    },
    "nodeRef": {
      "type": "object",
      "required": ["graph", "node"],
      "properties": {
        "graph": { "type": "string" },
        "node": { "type": "string" }
      }
    },
    "value": { "type": ["boolean", "number", "string"] },
    "expr": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "value"],
          "properties": {
            "kind": { "const": "literal" },
            "value": { "$ref": "#/$defs/value" }
          }
        },
        {
          "type": "object",
          "required": ["kind", "name"],
          "properties": {
            "kind": { "const": "var" },
            "name": { "type": "string" }
          }
        },
        {
          "type": "object",
          "required": ["kind", "op", "arg"],
          "properties": {
            "kind": { "const": "unary" },
            "op": { "enum": ["not", "neg"] },
            "arg": { "$ref": "#/$defs/expr" }
          }
        },
        {
          "type": "object",
          "required": ["kind", "op", "left", "right"],
          "properties": {
            "kind": { "const": "binary" },
            "op": {
              "enum": [
                "or",
                "and",
                "==",
                "!=",
                "<",
                "<=",
                ">",
                ">=",
                "+",
                "-",
                "*",
                "/",
                "%"
              ]
            },
            "left": { "$ref": "#/$defs/expr" },
            "right": { "$ref": "#/$defs/expr" }
          }
        }
      ]
    },
    "condition": {
      "type": ["object", "null"],
      "required": ["source", "ast"],
      "properties": {
        "source": { "type": "string" },
        "ast": {
          "oneOf": [{ "$ref": "#/$defs/expr" }, { "type": "null" }],
          "description": "Null when the source does not parse."
        }
      }
    },
    "effects": {
      "type": ["object", "null"],
      "required": ["source", "effects"],
      "properties": {
        "source": { "type": "string" },
        "effects": {
          "type": ["array", "null"],
          "description": "Null when the source does not parse.",
          "items": {
            "type": "object",
            "required": ["target", "op", "value"],
            "properties": {
              "target": {
                "type": "string",
                "description": "fullName of the variable."
              },
              "op": { "enum": ["=", "+=", "-="] },
              "value": { "$ref": "#/$defs/expr" }
            }
          }
        }
      }
    },
    "variable": {
      "type": "object",
      "required": [
        "id",
        "name",
        "fullName",
        "type",
        "initial",
        "scope",
        "owner",
        "values",
        "description"
      ],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "fullName": {
          "type": "string",
          "description": "As written in expressions: Owner.name for a variable of a world card."
        },
        "type": {
          "enum": ["bool", "int", "float", "string", "enum", "entity"]
        },
        "initial": { "type": ["boolean", "number", "string", "null"] },
        "scope": {
          "oneOf": [
            { "const": "project" },
            {
              "type": "object",
              "required": ["graph"],
              "properties": { "graph": { "type": "string" } }
            }
          ]
        },
        "owner": { "type": ["string", "null"] },
        "values": { "type": ["array", "null"], "items": { "type": "string" } },
        "description": { "type": "string" }
      }
    },
    "entity": {
      "type": "object",
      "required": ["id", "type", "name", "description", "image"],
      "properties": {
        "id": { "type": "string" },
        "type": {
          "type": "string",
          "description": "A built-in type (character, location, item) or, since 0.3, the id of a type of the project's own: see schema.types; follow `parent` up to find the built-in it belongs to."
        },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "image": {
          "type": ["string", "null"],
          "description": "Path inside the project folder."
        },
        "values": {
          "type": "object",
          "description": "Since 0.3: field values by field id (see schema.types[].fields)."
        },
        "relations": {
          "type": "array",
          "description": "Since 0.3: relations kept at this entity; the other side sees them with inverseLabel.",
          "items": {
            "type": "object",
            "required": ["id", "to", "label", "inverseLabel", "description"],
            "properties": {
              "id": { "type": "string" },
              "to": { "type": "string" },
              "label": { "type": "string" },
              "inverseLabel": { "type": "string" },
              "description": { "type": "string" }
            }
          }
        }
      }
    },
    "edge": {
      "type": "object",
      "required": ["id", "from", "fromPort", "to", "label", "condition"],
      "properties": {
        "id": { "type": "string" },
        "from": { "type": "string" },
        "fromPort": {
          "type": "string",
          "description": "Option id for a choice, yes/no for a condition, a side otherwise."
        },
        "to": { "type": "string" },
        "label": { "type": ["string", "null"] },
        "condition": { "$ref": "#/$defs/condition" }
      }
    },
    "node": {
      "type": "object",
      "required": ["id", "kind", "title", "text", "x", "y"],
      "properties": {
        "id": { "type": "string" },
        "kind": {
          "enum": [
            "start",
            "scene",
            "dialogue",
            "choice",
            "condition",
            "effect",
            "butterfly",
            "gun",
            "jump",
            "chapter",
            "end",
            "character",
            "location",
            "item",
            "node"
          ]
        },
        "title": { "type": "string" },
        "text": { "type": "string" },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "comment": { "type": "string" },
        "plotRole": { "enum": ["consequence", "payoff"] },
        "plotRoles": { "type": "array", "items": { "enum": ["consequence", "payoff"] } },
        "lines": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "speaker", "text"],
            "properties": {
              "id": { "type": "string" },
              "speaker": { "type": ["string", "null"] },
              "text": { "type": "string" }
            }
          }
        },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "text", "condition", "effects"],
            "properties": {
              "id": { "type": "string" },
              "text": { "type": "string" },
              "condition": { "$ref": "#/$defs/condition" },
              "effects": { "$ref": "#/$defs/effects" },
              "note": {
                "type": "string",
                "description": "Since 0.3: the designer's comment on the option."
              },
              "textEffects": {
                "$ref": "#/$defs/effects",
                "description": "Since 0.3: effects written in the option's text (in braces) and its comment, applied after `effects` when the option is chosen."
              }
            }
          }
        },
        "textEffects": {
          "$ref": "#/$defs/effects",
          "description": "Since 0.3: effects written in the node's text, comment and lines, applied when the node is shown."
        },
        "marks": {
          "type": "array",
          "description": "Since 0.3: plot devices laid over the node, an option or a line, or words of their text.",
          "items": {
            "type": "object",
            "required": [
              "id",
              "device",
              "anchor",
              "range",
              "links",
              "note",
              "variables"
            ],
            "properties": {
              "id": { "type": "string" },
              "device": {
                "type": "string",
                "description": "gun or butterfly; more devices may follow."
              },
              "anchor": {
                "type": "object",
                "required": ["kind"],
                "properties": {
                  "kind": { "enum": ["node", "option", "line"] },
                  "id": { "type": "string" }
                }
              },
              "range": {
                "oneOf": [
                  {
                    "type": "object",
                    "required": ["start", "end", "quote"],
                    "properties": {
                      "start": { "type": "integer" },
                      "end": { "type": "integer" },
                      "quote": { "type": "string" }
                    }
                  },
                  { "type": "null" }
                ]
              },
              "links": {
                "type": "array",
                "items": { "$ref": "#/$defs/nodeRef" }
              },
              "note": { "type": "string" },
              "variables": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "condition": { "$ref": "#/$defs/condition" },
        "effects": { "$ref": "#/$defs/effects" },
        "consequences": {
          "type": "array",
          "items": { "$ref": "#/$defs/nodeRef" }
        },
        "payoffs": { "type": "array", "items": { "$ref": "#/$defs/nodeRef" } },
        "target": {
          "oneOf": [{ "$ref": "#/$defs/nodeRef" }, { "type": "null" }]
        },
        "graph": { "type": ["string", "null"] },
        "image": { "type": ["string", "null"] },
        "entity": { "type": ["string", "null"] }
      }
    },
    "graph": {
      "type": "object",
      "required": ["id", "kind", "name", "parent", "start", "nodes", "edges"],
      "properties": {
        "id": { "type": "string" },
        "kind": { "enum": ["story", "chapter"] },
        "name": { "type": "string" },
        "parent": {
          "oneOf": [{ "$ref": "#/$defs/nodeRef" }, { "type": "null" }]
        },
        "start": { "type": ["string", "null"] },
        "nodes": { "type": "array", "items": { "$ref": "#/$defs/node" } },
        "edges": { "type": "array", "items": { "$ref": "#/$defs/edge" } }
      }
    }
  }
}
