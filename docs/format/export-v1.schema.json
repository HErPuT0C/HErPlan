{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/HErPuT0C/HErPlan/blob/main/docs/format/export-v1.schema.json",
  "title": "HErPlan story export, version 1",
  "description": "Story graphs, variables and world cards exported for game engines. See export-v1.md. Unknown fields may appear in later exports with the same version and must be ignored.",
  "type": "object",
  "required": [
    "format",
    "version",
    "exportedWith",
    "exportedAt",
    "project",
    "variables",
    "entities",
    "story"
  ],
  "properties": {
    "format": { "const": "herplan-export" },
    "version": { "const": 1 },
    "exportedWith": {
      "type": "string",
      "description": "HErPlan version that wrote the file."
    },
    "exportedAt": { "type": "string", "format": "date-time" },
    "project": {
      "type": "object",
      "required": ["id", "name"],
      "properties": { "id": { "type": "string" }, "name": { "type": "string" } }
    },
    "variables": { "type": "array", "items": { "$ref": "#/$defs/variable" } },
    "entities": { "type": "array", "items": { "$ref": "#/$defs/entity" } },
    "schema": {
      "type": "object",
      "description": "Since 0.3: entity types (each with every field its entities have) and property sets.",
      "required": ["types", "propertySets"],
      "properties": {
        "types": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name", "builtIn", "parent", "fields"],
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "builtIn": { "type": "boolean" },
              "parent": { "type": ["string", "null"] },
              "fields": {
                "type": "array",
                "items": { "$ref": "#/$defs/field" }
              }
            }
          }
        },
        "propertySets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name", "fields"],
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "fields": {
                "type": "array",
                "items": { "$ref": "#/$defs/field" }
              }
            }
          }
        },
        "catalogs": {
          "type": "array",
          "description": "Since 0.4: catalogs of tags; values of \"tags\" fields are tag ids.",
          "items": {
            "type": "object",
            "required": ["id", "name", "tags"],
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "tags": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["id", "name", "description", "color"],
                  "properties": {
                    "id": { "type": "string" },
                    "name": { "type": "string" },
                    "description": { "type": "string" },
                    "color": { "type": ["string", "null"] }
                  }
                }
              }
            }
          }
        }
      }
    },
    "story": {
      "type": "object",
      "required": ["root", "graphs"],
      "properties": {
        "root": {
          "type": ["string", "null"],
          "description": "Id of the chapter overview graph."
        },
        "graphs": { "type": "array", "items": { "$ref": "#/$defs/graph" } }
      }
    }
  },
  "$defs": {
    "field": {
      "type": "object",
      "required": ["id", "label", "type"],
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "type": {
          "enum": [
            "text",
            "richtext",
            "number",
            "percent",
            "bool",
            "enum",
            "ref",
            "refList",
            "tags",
            "image",
            "color",
            "table"
          ]
        },
        "options": { "type": "array", "items": { "type": "string" } },
        "target": { "type": ["string", "null"] },
        "columns": { "type": "array", "items": { "type": "string" } },
        "catalog": { "type": ["string", "null"] }
      }
    },
    "nodeRef": {
      "type": "object",
      "required": ["graph", "node"],
      "properties": {
        "graph": { "type": "string" },
        "node": { "type": "string" }
      }
    },
    "value": { "type": ["boolean", "number", "string"] },
    "expr": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "value"],
          "properties": {
            "kind": { "const": "literal" },
            "value": { "$ref": "#/$defs/value" }
          }
        },
        {
          "type": "object",
          "required": ["kind", "name"],
          "properties": {
            "kind": { "const": "var" },
            "name": { "type": "string" }
          }
        },
        {
          "type": "object",
          "required": ["kind", "op", "arg"],
          "properties": {
            "kind": { "const": "unary" },
            "op": { "enum": ["not", "neg"] },
            "arg": { "$ref": "#/$defs/expr" }
          }
        },
        {
          "type": "object",
          "required": ["kind", "op", "left", "right"],
          "properties": {
            "kind": { "const": "binary" },
            "op": {
              "enum": [
                "or",
                "and",
                "==",
                "!=",
                "<",
                "<=",
                ">",
                ">=",
                "+",
                "-",
                "*",
                "/",
                "%"
              ]
            },
            "left": { "$ref": "#/$defs/expr" },
            "right": { "$ref": "#/$defs/expr" }
          }
        },
        {
          "type": "object",
          "required": ["kind", "fn", "arg", "ref"],
          "description": "Since 0.8: a question to the game. has: the hero has an item; hired: a companion is hired; seen: the player saw a line or chose an option; notEmpty: a list variable is not empty. `arg` is the name as written, `ref` the id it names (entity, line or option, variable), null when nothing has that name.",
          "properties": {
            "kind": { "const": "call" },
            "fn": { "enum": ["has", "hired", "seen", "notEmpty"] },
            "arg": { "type": "string" },
            "ref": { "type": ["string", "null"] }
          }
        }
      ]
    },
    "condition": {
      "type": ["object", "null"],
      "required": ["source", "ast"],
      "properties": {
        "source": { "type": "string" },
        "ast": {
          "oneOf": [{ "$ref": "#/$defs/expr" }, { "type": "null" }],
          "description": "Null when the source does not parse."
        }
      }
    },
    "effects": {
      "type": ["object", "null"],
      "required": ["source", "effects"],
      "properties": {
        "source": { "type": "string" },
        "effects": {
          "type": ["array", "null"],
          "description": "Null when the source does not parse.",
          "items": {
            "type": "object",
            "required": ["target", "op", "value"],
            "properties": {
              "target": {
                "type": "string",
                "description": "fullName of the variable."
              },
              "op": { "enum": ["=", "+=", "-="] },
              "value": { "$ref": "#/$defs/expr" }
            }
          }
        }
      }
    },
    "variable": {
      "type": "object",
      "required": [
        "id",
        "name",
        "fullName",
        "type",
        "initial",
        "scope",
        "owner",
        "values",
        "description"
      ],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "fullName": {
          "type": "string",
          "description": "As written in expressions: Owner.name for a variable of a world card."
        },
        "type": {
          "enum": ["bool", "int", "float", "string", "enum", "entity", "list"]
        },
        "initial": { "type": ["boolean", "number", "string", "null"] },
        "scope": {
          "oneOf": [
            { "const": "project" },
            {
              "type": "object",
              "required": ["graph"],
              "properties": { "graph": { "type": "string" } }
            }
          ]
        },
        "owner": { "type": ["string", "null"] },
        "values": { "type": ["array", "null"], "items": { "type": "string" } },
        "description": { "type": "string" },
        "key": {
          "type": "string",
          "description": "Since 0.8: the name in the game, present when it has one."
        },
        "memory": {
          "enum": ["world", "game"],
          "description": "Since 0.8: where the game keeps the variable: in the save (world) or outside saves (game)."
        }
      }
    },
    "entity": {
      "type": "object",
      "required": ["id", "type", "name", "description", "image"],
      "properties": {
        "id": { "type": "string" },
        "type": {
          "type": "string",
          "description": "A built-in type (character, location, item) or, since 0.3, the id of a type of the project's own: see schema.types; follow `parent` up to find the built-in it belongs to."
        },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "image": {
          "type": ["string", "null"],
          "description": "Path inside the project folder."
        },
        "values": {
          "type": "object",
          "description": "Since 0.3: field values by field id (see schema.types[].fields). Since 0.5 without the type's fields this entity hides (hiddenFields) and with its own fields (fields)."
        },
        "fields": {
          "type": "array",
          "description": "Since 0.5: fields of this entity only, present when it has any.",
          "items": { "$ref": "#/$defs/field" }
        },
        "hiddenFields": {
          "type": "array",
          "description": "Since 0.5: ids of fields of the entity's type this entity does not have, present when there are any.",
          "items": { "type": "string" }
        },
        "relations": {
          "type": "array",
          "description": "Since 0.3: relations kept at this entity; the other side sees them with inverseLabel.",
          "items": {
            "type": "object",
            "required": ["id", "to", "label", "inverseLabel", "description"],
            "properties": {
              "id": { "type": "string" },
              "to": { "type": "string" },
              "label": { "type": "string" },
              "inverseLabel": { "type": "string" },
              "description": { "type": "string" }
            }
          }
        },
        "key": {
          "type": "string",
          "description": "Since 0.8, like the fields below, present only when set: the name in the game."
        },
        "bubble": {
          "type": "string",
          "description": "Character: the shape of the speech bubble (palette id)."
        },
        "voice": {
          "type": "string",
          "description": "Character: the voice (palette id)."
        },
        "pitch": {
          "type": "number",
          "description": "Character: the pitch of the voice, 1 as recorded."
        },
        "faces": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Character: the faces drawn for them (palette ids)."
        }
      }
    },
    "edge": {
      "type": "object",
      "required": ["id", "from", "fromPort", "to", "label", "condition"],
      "properties": {
        "id": { "type": "string" },
        "from": { "type": "string" },
        "fromPort": {
          "type": "string",
          "description": "Option id for a choice, yes/no for a condition, a side otherwise. Since 0.8: a line id for the exit of an interrupted line, given/cancel/empty for a give node."
        },
        "to": { "type": "string" },
        "label": { "type": ["string", "null"] },
        "condition": { "$ref": "#/$defs/condition" }
      }
    },
    "node": {
      "type": "object",
      "required": ["id", "kind", "title", "text", "x", "y"],
      "properties": {
        "id": { "type": "string" },
        "kind": {
          "enum": [
            "start",
            "scene",
            "dialogue",
            "choice",
            "condition",
            "effect",
            "butterfly",
            "gun",
            "jump",
            "chapter",
            "end",
            "character",
            "location",
            "item",
            "node",
            "give",
            "barks"
          ]
        },
        "title": { "type": "string" },
        "text": { "type": "string" },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "comment": { "type": "string" },
        "plotRole": { "enum": ["consequence", "payoff"] },
        "plotRoles": {
          "type": "array",
          "items": { "enum": ["consequence", "payoff"] }
        },
        "lines": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "speaker", "text"],
            "properties": {
              "id": { "type": "string" },
              "speaker": {
                "type": ["string", "null"],
                "description": "An entity id; since 0.8.1 \"narrator\" for the narrator, null when nobody was chosen."
              },
              "text": { "type": "string" },
              "style": {
                "type": "string",
                "description": "Since 0.8, like the fields below, present only when set: the style of the whole line (palette id)."
              },
              "face": {
                "type": "string",
                "description": "The face the speaker's sprite takes (palette id)."
              },
              "gesture": { "$ref": "#/$defs/toward" },
              "emote": { "$ref": "#/$defs/toward" },
              "auto": {
                "type": "number",
                "description": "Seconds until the line goes on by itself; absent: waits for a press."
              },
              "interrupt": {
                "type": "number",
                "description": "Seconds the line can be interrupted for; absent: as the game decides, 0: cannot be interrupted."
              },
              "condition": {
                "$ref": "#/$defs/condition",
                "description": "The line is shown only when this holds."
              },
              "effects": {
                "$ref": "#/$defs/effects",
                "description": "Applied after the line."
              },
              "actions": { "$ref": "#/$defs/actions" }
            }
          }
        },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "text", "condition", "effects"],
            "properties": {
              "id": { "type": "string" },
              "text": { "type": "string" },
              "condition": { "$ref": "#/$defs/condition" },
              "effects": { "$ref": "#/$defs/effects" },
              "note": {
                "type": "string",
                "description": "Since 0.3: the designer's comment on the option."
              },
              "textEffects": {
                "$ref": "#/$defs/effects",
                "description": "Since 0.3: effects written in the option's text (in braces) and its comment, applied after `effects` when the option is chosen."
              },
              "secret": {
                "type": "boolean",
                "description": "Since 0.8: not shown to the player, taken when the choice's time runs out."
              },
              "once": {
                "type": "boolean",
                "description": "Since 0.8: shown once, gone after it was chosen."
              },
              "actions": { "$ref": "#/$defs/actions" }
            }
          }
        },
        "textEffects": {
          "$ref": "#/$defs/effects",
          "description": "Since 0.3: effects written in the node's text, comment and lines, applied when the node is shown."
        },
        "marks": {
          "type": "array",
          "description": "Since 0.3: plot devices laid over the node, an option or a line, or words of their text. Since 0.8 also the game's marks on dialogue lines: `style` (how words look; `props`) and `cue` (something at a point of the line: `range.start` = `range.end`; `props`); these have `props` instead of links, note and variables.",
          "items": {
            "type": "object",
            "required": ["id", "device", "anchor", "range"],
            "properties": {
              "id": { "type": "string" },
              "device": {
                "type": "string",
                "description": "gun or butterfly (plot devices); since 0.8 style or cue (the game's marks)."
              },
              "anchor": {
                "type": "object",
                "required": ["kind"],
                "properties": {
                  "kind": { "enum": ["node", "option", "line"] },
                  "id": { "type": "string" }
                }
              },
              "range": {
                "oneOf": [
                  {
                    "type": "object",
                    "required": ["start", "end", "quote"],
                    "properties": {
                      "start": { "type": "integer" },
                      "end": { "type": "integer" },
                      "quote": { "type": "string" }
                    }
                  },
                  { "type": "null" }
                ]
              },
              "links": {
                "type": "array",
                "items": { "$ref": "#/$defs/nodeRef" }
              },
              "note": { "type": "string" },
              "variables": { "type": "array", "items": { "type": "string" } },
              "props": {
                "type": "object",
                "description": "Since 0.8. style: style, color (#rrggbb), size, bold, effect, speed (times faster), reveal. cue: exactly one of pause (seconds), shake (strength), sound, gesture, emote, face; gesture and emote are a palette id or {id, to}.",
                "properties": {
                  "style": { "type": "string" },
                  "color": { "type": "string" },
                  "size": { "type": "string" },
                  "bold": { "type": "boolean" },
                  "effect": { "type": "string" },
                  "speed": { "type": "number" },
                  "reveal": { "type": "string" },
                  "pause": { "type": "number" },
                  "shake": { "type": "number" },
                  "sound": { "type": "string" },
                  "face": {
                    "oneOf": [
                      { "type": "string" },
                      {
                        "type": "object",
                        "required": ["id"],
                        "properties": {
                          "id": { "type": "string" },
                          "to": { "type": ["string", "null"] }
                        }
                      }
                    ],
                    "description": "Since 0.8.1 a face cue may be for another participant, like a gesture."
                  },
                  "gesture": {
                    "oneOf": [
                      { "type": "string" },
                      {
                        "type": "object",
                        "required": ["id"],
                        "properties": {
                          "id": { "type": "string" },
                          "to": { "type": ["string", "null"] }
                        }
                      }
                    ]
                  },
                  "emote": {
                    "oneOf": [
                      { "type": "string" },
                      {
                        "type": "object",
                        "required": ["id"],
                        "properties": {
                          "id": { "type": "string" },
                          "to": { "type": ["string", "null"] }
                        }
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "condition": { "$ref": "#/$defs/condition" },
        "effects": { "$ref": "#/$defs/effects" },
        "consequences": {
          "type": "array",
          "items": { "$ref": "#/$defs/nodeRef" }
        },
        "payoffs": { "type": "array", "items": { "$ref": "#/$defs/nodeRef" } },
        "target": {
          "oneOf": [{ "$ref": "#/$defs/nodeRef" }, { "type": "null" }]
        },
        "graph": {
          "type": ["string", "null"],
          "description": "Since 0.8 also the graph of a set of lines (barks)."
        },
        "image": { "type": ["string", "null"] },
        "entity": { "type": ["string", "null"] },
        "timer": {
          "type": "number",
          "description": "Since 0.8, choice: seconds to choose; absent: no timer. When it runs out the game takes the option the player is on (or the secret one)."
        },
        "checkpoint": {
          "type": "boolean",
          "description": "Since 0.8, choice: the game saves before it."
        },
        "actions": { "$ref": "#/$defs/actions" },
        "store": {
          "type": ["string", "null"],
          "description": "Since 0.8, give: the variable that gets what was given (id)."
        },
        "keep": {
          "type": ["string", "null"],
          "description": "Since 0.8, give: the list variable what was given is added to (id)."
        },
        "when": {
          "type": "string",
          "description": "Since 0.8, a dialogue node of a set of lines (barks): when the game says them."
        }
      }
    },
    "graph": {
      "type": "object",
      "required": ["id", "kind", "name", "parent", "start", "nodes", "edges"],
      "properties": {
        "id": { "type": "string" },
        "kind": { "enum": ["story", "chapter", "barks"] },
        "name": { "type": "string" },
        "parent": {
          "oneOf": [{ "$ref": "#/$defs/nodeRef" }, { "type": "null" }]
        },
        "start": { "type": ["string", "null"] },
        "nodes": { "type": "array", "items": { "$ref": "#/$defs/node" } },
        "edges": { "type": "array", "items": { "$ref": "#/$defs/edge" } },
        "key": {
          "type": "string",
          "description": "Since 0.8: the name of the conversation in the game, present when it has one."
        }
      }
    },
    "toward": {
      "type": "object",
      "required": ["id", "to"],
      "properties": {
        "id": { "type": "string" },
        "to": {
          "type": ["string", "null"],
          "description": "The entity it is aimed at, or null."
        }
      },
      "description": "Since 0.8: a gesture or an emote (palette id), optionally aimed at another participant."
    },
    "actions": {
      "type": "array",
      "description": "Since 0.8: what the game does besides changing variables.",
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": {
            "enum": [
              "give_item",
              "take_item",
              "hire",
              "dismiss",
              "list_add",
              "give_list",
              "save",
              "event",
              "start_quest"
            ]
          },
          "ref": {
            "type": "string",
            "description": "give_item, take_item: an item; hire, dismiss: a character; list_add, give_list: a list variable (ids)."
          },
          "item": {
            "type": "string",
            "description": "list_add: the item put on the list (entity id)."
          },
          "value": {
            "type": "string",
            "description": "list_add: a value of its own; event, start_quest: the key the game knows."
          }
        }
      }
    }
  }
}
